# XZRecruiter Supabase project. Do not commit a real project URL/key here.
# Configure these values for each environment (local/staging/production).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_XZRECRUITER_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional server-only aliases. Prefer these when the server should not depend on NEXT_PUBLIC names.
XZRECRUITER_SUPABASE_URL=https://YOUR_XZRECRUITER_PROJECT_REF.supabase.co
XZRECRUITER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only secret used for private recruitment document storage. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SECURE_RUNTIME_ONLY
XZRECRUITER_STORAGE_BUCKET=xzrecruiter-private
XZRECRUITER_SENSITIVE_STORAGE_BUCKET=xzrecruiter-private

# Malware scanning is fail-closed in production.
XZRECRUITER_MALWARE_SCAN_URL=https://scanner.example.invalid/scan
XZRECRUITER_MALWARE_SCAN_TOKEN=REPLACE_IN_SECURE_RUNTIME_ONLY
XZRECRUITER_MALWARE_SCAN_TIMEOUT_MS=5000
# Development-only escape hatch. This is ignored in production.
XZRECRUITER_ALLOW_UNSCANNED_UPLOADS=false

# Direct database URLs are server-only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
XZRECRUITER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
XZRECRUITER_PERF_DATABASE_URL=postgresql://USER:PASSWORD@NON_PRODUCTION_HOST:5432/postgres

SESSION_COOKIE_SECURE=true

# Enterprise session telemetry. Use a high-entropy server-only value; raw IPs are never persisted.
XZRECRUITER_TELEMETRY_HASH_KEY=REPLACE_WITH_HIGH_ENTROPY_SERVER_SECRET

# Enterprise connector token envelope key: exactly 32 random bytes encoded as base64.
XZRECRUITER_INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Google Workspace OAuth (Gmail + Calendar).
GOOGLE_CLIENT_ID=REPLACE_IN_SECURE_RUNTIME_ONLY
GOOGLE_CLIENT_SECRET=REPLACE_IN_SECURE_RUNTIME_ONLY
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_APP/api/integrations/google/callback

# Microsoft 365 OAuth / Microsoft Graph (Mail + Calendar).
MICROSOFT_CLIENT_ID=REPLACE_IN_SECURE_RUNTIME_ONLY
MICROSOFT_CLIENT_SECRET=REPLACE_IN_SECURE_RUNTIME_ONLY
MICROSOFT_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=https://YOUR_APP/api/integrations/microsoft/callback

# Retention automation is dry-run unless explicitly enabled by the workflow/runtime.
XZRECRUITER_RETENTION_EXECUTE=false
XZRECRUITER_RETENTION_LIMIT=100

